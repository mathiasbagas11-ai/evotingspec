# ─────────────────────────────────────────────────────────────
# CONTOH env. COPY file ini jadi `.env.local` lalu isi nilai asli.
# `.env.local` TIDAK di-commit (lihat .gitignore).
# SEMUA tanpa prefix NEXT_PUBLIC_ — ini rahasia server, jangan bocor ke browser.
# ─────────────────────────────────────────────────────────────

# URL Web App Apps Script (yang /exec, dari Manage deployments)
APPS_SCRIPT_URL=https://script.google.com/macros/s/XXXX/exec

# Samakan PERSIS dengan SHARED_SECRET di Script Properties Apps Script
SHARED_SECRET=samakan-dengan-Script-Properties

# Password buat login dashboard /admin (bebas, yang kuat)
ADMIN_PASSWORD=ganti-dengan-password-admin-kuat

# Random 32+ char buat ngunci cookie login admin (beda dari SHARED_SECRET)
# Generate: openssl rand -hex 32
SESSION_SECRET=ganti-dengan-random-32-char
